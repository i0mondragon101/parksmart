-- One app profile per Supabase Auth user.
create table public.profiles (
 id uuid primary key references auth.users (id) on delete cascade,
 display_name text,
 created_at timestamptz not null default now()
);


-- Each row represents one complete campus parking location.
create table public.parking_locations (
 parking_location_id uuid primary key default gen_random_uuid(),
 location_name text not null,
 latitude numeric(9, 6) not null
   check (latitude between -90 and 90),
 longitude numeric(10, 7) not null
   check (longitude between -180 and 180),
 permit_requirement text,
 parking_cost numeric(10, 2)
   check (parking_cost is null or parking_cost >= 0)
);


create table public.parking_reports (
 parking_report_id uuid primary key default gen_random_uuid(),
 student_id uuid not null
   references public.profiles (id) on delete cascade,
 parking_location_id uuid not null
   references public.parking_locations (parking_location_id),
 reported_condition text not null
   check (reported_condition in ('Open', 'Nearly Full', 'Full')),
 submitted_at timestamptz not null default now(),
 verification_status text
);


create index parking_reports_location_submitted_idx
 on public.parking_reports (parking_location_id, submitted_at desc);


create index parking_reports_student_idx
 on public.parking_reports (student_id);


-- At most one stored recent route per student.
create table public.recent_routes (
 recent_route_id uuid primary key default gen_random_uuid(),
 student_id uuid not null unique
   references public.profiles (id) on delete cascade,
 parking_location_id uuid not null
   references public.parking_locations (parking_location_id),
 route_started_at timestamptz not null,
 updated_at timestamptz not null default now()
);


-- Keep updated_at current when a route is changed.
create function public.set_recent_route_updated_at()
returns trigger
language plpgsql
set search_path = ''
as $$
begin
 new.updated_at := now();
 return new;
end;
$$;


create trigger recent_routes_set_updated_at
before update on public.recent_routes
for each row
execute function public.set_recent_route_updated_at();


-- Create a profile from Auth user metadata on signup.
create function public.handle_new_user_profile()
returns trigger
language plpgsql
security definer
set search_path = ''
as $$
begin
 insert into public.profiles (id, display_name, created_at)
 values (
   new.id,
   nullif(new.raw_user_meta_data ->> 'display_name', ''),
   new.created_at
 )
 on conflict (id) do nothing;


 return new;
end;
$$;


create trigger on_auth_user_created_create_profile
after insert on auth.users
for each row
execute function public.handle_new_user_profile();


revoke all on function public.handle_new_user_profile()
 from public, anon, authenticated;


-- Enable row-level security.
alter table public.profiles enable row level security;
alter table public.parking_locations enable row level security;
alter table public.parking_reports enable row level security;
alter table public.recent_routes enable row level security;


-- Parking locations can be listed without signing in.
create policy "Parking locations are readable"
on public.parking_locations
for select
to anon, authenticated
using (true);


-- Students can access and update only their own profile.
create policy "Students can read their own profile"
on public.profiles
for select
to authenticated
using ((select auth.uid()) = id);


create policy "Students can update their own profile"
on public.profiles
for update
to authenticated
using ((select auth.uid()) = id)
with check ((select auth.uid()) = id);


-- Signed-in students can read reports and submit reports as themselves.
create policy "Reports are readable by authenticated students"
on public.parking_reports
for select
to authenticated
using (true);


create policy "Students can submit their own reports"
on public.parking_reports
for insert
to authenticated
with check ((select auth.uid()) = student_id);


-- Students can manage only their own recent route.
create policy "Students can read their own recent route"
on public.recent_routes
for select
to authenticated
using ((select auth.uid()) = student_id);


create policy "Students can create their own recent route"
on public.recent_routes
for insert
to authenticated
with check ((select auth.uid()) = student_id);


create policy "Students can update their own recent route"
on public.recent_routes
for update
to authenticated
using ((select auth.uid()) = student_id)
with check ((select auth.uid()) = student_id);


create policy "Students can delete their own recent route"
on public.recent_routes
for delete
to authenticated
using ((select auth.uid()) = student_id);


-- Grant the table operations used by the policies.
grant select on public.parking_locations to anon, authenticated;
grant select, update on public.profiles to authenticated;
grant select, insert on public.parking_reports to authenticated;
grant select, insert, update, delete on public.recent_routes to authenticated;


commit;





